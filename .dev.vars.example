# Скопируйте в .dev.vars для локальной разработки: npx wrangler dev
# В продакшене — npx wrangler secret put <ИМЯ>

# Telegram-уведомления о заявках: бот из @BotFather, chat_id из getUpdates
# (у групп он отрицательный, вида -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# /studio: хеш пароля в формате sha256$<salt_b64>$<hash_b64> и секрет подписи сессии.
# Сгенерировать: python scripts/make-admin-password.py
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# GitHub PAT для публикации статей: fine-grained, Contents: Read and write.
GITHUB_TOKEN=

# Ключ Web3Forms здесь НЕ нужен: он публичный и лежит в public/lead.js, потому что
# бесплатный тариф Web3Forms принимает запросы только из браузера.
