# Скопируйте в .dev.vars для локальной разработки: npx wrangler dev
# В продакшене — npx wrangler secret put <ИМЯ>

# Telegram-уведомления: бот создаётся через @BotFather, chat_id — ваш личный или группы
# (у групп он отрицательный, вида -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключ Web3Forms здесь НЕ нужен: он публичный и лежит в lead.js, потому что
# бесплатный тариф Web3Forms принимает запросы только из браузера.
