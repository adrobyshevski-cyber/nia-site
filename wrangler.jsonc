{
  // Имя существующего Worker'а: к нему привязаны narrativeintelligence.ru и www.
  "name": "broad-paper-a8b7",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  // Сайт живёт только на своём домене: workers.dev-копия дала бы дубли контента в поиске.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "AUDIT_KV", "id": "d4bb0d870ea84be287c6b7e90bc5376a" }
  ],
  "vars": {
    // stub — воронка на заглушке; live — реальный StoryAudit по AUDIT_SERVICE_URL
    "AUDIT_ENGINE": "stub",
    // адрес сервиса после деплоя на Render: https://audit.narrativeintelligence.ru
    "AUDIT_SERVICE_URL": ""
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
