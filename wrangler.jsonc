{
  // Имя существующего Worker'а: к нему привязаны narrativeintelligence.ru и www.
  "name": "broad-paper-a8b7",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  // Сайт живёт только на своём домене: workers.dev-копия дала бы дубли контента в поиске.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "AUDIT_KV", "id": "d4bb0d870ea84be287c6b7e90bc5376a" }
  ],
  // CRM (/crm): биндинг DB. Схема — migrations/0001_init.sql.
  "d1_databases": [
    { "binding": "DB", "database_name": "nia-crm", "database_id": "8b00676a-4065-477c-a031-02bfebbbc7bf" }
  ],
  "vars": {
    // stub — воронка на заглушке; live — реальный StoryAudit по AUDIT_SERVICE_URL
    "AUDIT_ENGINE": "live",
    // StoryAudit на локальной машине через Cloudflare Tunnel
    "AUDIT_SERVICE_URL": "https://audit.narrativeintelligence.ru",
    // Авто-публикация отчётов /demo без ручного Stage Gate.
    // "0" — каждый отчёт подтверждается вручную, "1" — публикуем сразу (включено 2026-11-27).
    "AUDIT_AUTO_PUBLISH": "1",
    // CRM: сколько дней хранить персональные данные лида (152-ФЗ).
    // Чистка — worker.js → scheduled, раз в сутки в 03:00 UTC.
    "CRM_RETENTION_DAYS": "180"
  },
  // Напоминания CRM по deals.next_step_at (см. worker.js → scheduled).
  // Каждые 15 минут: deals.reminded_at не даёт отправить дважды.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
