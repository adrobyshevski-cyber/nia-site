{
  // Имя существующего Worker'а: к нему привязаны narrativeintelligence.ru и www.
  "name": "broad-paper-a8b7",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  // Сайт живёт только на своём домене: workers.dev-копия дала бы дубли контента в поиске.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "AUDIT_KV", "id": "d4bb0d870ea84be287c6b7e90bc5376a" }
  ],
  // CRM (/crm). Раскомментировать после `npx wrangler d1 create nia-crm`:
  // id из вывода команды; migrations/0001_init.sql применяется отдельно.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "nia-crm", "database_id": "<uuid из wrangler d1 create>" }
  // ],
  "vars": {
    // stub — воронка на заглушке; live — реальный StoryAudit по AUDIT_SERVICE_URL
    "AUDIT_ENGINE": "live",
    // StoryAudit на локальной машине через Cloudflare Tunnel
    "AUDIT_SERVICE_URL": "https://audit.narrativeintelligence.ru"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
