{
  // Имя существующего Worker'а: к нему привязаны narrativeintelligence.ru и www.
  "name": "broad-paper-a8b7",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  // Сайт живёт только на своём домене: workers.dev-копия дала бы дубли контента в поиске.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
